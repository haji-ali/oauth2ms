import argparse
import contextlib
import fcntl
import webbrowser
import msal
import git
import sys
import time
import uuid
import os
import base64
import passpy
import http.server
import ssl
from urllib.parse import urlparse, parse_qs
from xdg.BaseDirectory import load_data_paths, save_cache_path

# How long an interactive sign-in may wait for the browser's redirect.
LOGIN_TIMEOUT = 300

def fail(message):
    print("oauth2ms: " + message, file=sys.stderr)
    sys.exit(1)

def parse_key(text):
    """Parse a pass entry: the password, then `key: value' lines.

    The first line is the password unless it is itself `key: value'. A
    key given more than once collects its values in a list; any other
    line is kept, in order, under `comments'.
    """
    entry = {}
    lines = text.splitlines()
    if lines:
        line = lines.pop(0)
        if ': ' in line:
            (key, value) = line.split(': ', 1)
            entry[key] = value
        else:
            entry['password'] = line
    comments = []
    for line in lines:
        if ': ' in line:
            (key, value) = line.split(': ', 1)
            if key in entry:
                if isinstance(entry[key], list):
                    entry[key].append(value)
                else:
                    entry[key] = [entry[key], value]
            else:
                entry[key] = value
        elif line.startswith('otpauth://'):
            entry['otpauth'] = line
        else:
            comments.append(line)
    if comments:
        entry['comments'] = '\n'.join(comments)
    return entry

class HTTPSHandler(object):
    SUCCESS_MESSAGE = "Authorization complete."
    FAILURE_MESSAGE = "Authorization failed."

    class HTTPSHandlerImpl(http.server.BaseHTTPRequestHandler):
        def __init__(self, data, *args):
            self.data = data
            super().__init__(*args)

        def log_message(self, format, *args):
            pass

        def do_GET(self):
            self.data(self)

    def __init__(self):
        self.params = None

    def __call__(self, request):
        params = parse_qs(urlparse(request.path).query)
        if 'code' not in params and 'error' not in params:
            # Not the redirect: the browser asking for a favicon, say.
            request.send_error(404)
            return
        self.params = params
        request.send_response(200)
        request.send_header("Content-type", "text/html")
        request.end_headers()
        message = (HTTPSHandler.SUCCESS_MESSAGE if 'code' in params
                   else HTTPSHandler.FAILURE_MESSAGE)
        request.wfile.write(message.encode("utf-8"))

    def handler_class(self):
        return lambda *args: HTTPSHandler.HTTPSHandlerImpl(self, *args)

def build_msal_app(config, cache=None):
    if 'client_secret' in config:
        return msal.ConfidentialClientApplication(
            config['client_id'],
            authority=config['authority'],
            client_credential=config['client_secret'],
            token_cache=cache)
    return msal.PublicClientApplication(config['client_id'],
                                        authority=config['authority'],
                                        token_cache=cache)

def wait_for_redirect(http_server, data):
    """Serve requests until the redirect arrives or LOGIN_TIMEOUT passes."""
    deadline = time.monotonic() + LOGIN_TIMEOUT
    while data.params is None:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            return None
        http_server.timeout = remaining
        http_server.handle_request()
    return data.params

def build_new_app_state(config, no_browser=False):
    cache = msal.SerializableTokenCache()
    state = str(uuid.uuid4())
    uri = config["redirect_uri"]
    msal_app = build_msal_app(config, cache)
    app_state = {"config": config, "cache": cache, "app": msal_app}
    auth_url = msal_app.get_authorization_request_url(config['scopes'],
                                                      state=state,
                                                      redirect_uri=uri)
    parsed_uri = urlparse(uri)
    redirect_port = parsed_uri.port or (443 if parsed_uri.scheme == "https"
                                        else 80)

    data = HTTPSHandler()
    http_server = http.server.HTTPServer((parsed_uri.hostname, redirect_port),
                                         data.handler_class())

    if uri.startswith("https"):
        # Genered server.pem with:
        # openssl req -new -x509 -keyout server.pem -out server.pem -days 365 -nodes
        cert = "ssl/certs/oauth2_server.pem"
        server_pem = next(load_data_paths(cert), None)
        if server_pem is None:
            http_server.server_close()
            fail("{} not found under any XDG data directory, but the "
                 "redirect URI is https".format(cert))
        ssl_context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
        ssl_context.load_cert_chain(certfile=server_pem, keyfile=server_pem)

        http_server.socket = ssl_context.wrap_socket(http_server.socket,
                                                     server_side=True)

    if no_browser:
        print("Please navigate to this url: " + auth_url, file=sys.stderr)
    else:
        webbrowser.open(auth_url, new=2, autoraise=True)

    try:
        params = wait_for_redirect(http_server, data)
    finally:
        http_server.server_close()

    if params is None:
        print("No authorization within {}s".format(LOGIN_TIMEOUT),
              file=sys.stderr)
        return (app_state, None)
    if params.get('state', [None])[0] != state:
        # Not the answer to the request made above.
        print("Authorization response has the wrong state", file=sys.stderr)
        return (app_state, None)
    if 'code' not in params:
        print("Authorization failed: {}: {}".format(
            params.get('error', ['?'])[0],
            params.get('error_description', [''])[0]), file=sys.stderr)
        return (app_state, None)

    result = msal_app.acquire_token_by_authorization_code(
        params['code'][0], scopes=config['scopes'], redirect_uri=uri)

    if result.get("access_token") is None:
        print("Something went wrong during authorization", file=sys.stderr)
        print("Server returned: {}".format(result), file=sys.stderr)
        return (app_state, None)

    return (app_state, result["access_token"])

def build_app_state_from_credentials(credentials, config):
    # Make sure it is a valid json object
    try:
        cache = msal.SerializableTokenCache()
        cache.deserialize(credentials)
    except (ValueError, TypeError):
        fail("Not a valid cache file")

    return {"config": config, "cache": cache,
            "app": build_msal_app(config, cache)}

def cached_token(pass_store, key, config):
    """Return (app_state, token) from the token cache stored under KEY.

    The token is None when it cannot be had without signing in again,
    and app_state too when there is no cache at all.
    """
    try:
        credentials = pass_store.get_key(key)
    except FileNotFoundError:
        return (None, None)
    app_state = build_app_state_from_credentials(credentials, config)
    accounts = app_state['app'].get_accounts()
    if not accounts:
        print("No account in the token cache", file=sys.stderr)
        return (app_state, None)
    # Unlike acquire_token_silent, says why a refresh failed.
    result = app_state['app'].acquire_token_silent_with_error(
        config['scopes'], account=accounts[0])
    if result is None:
        return (app_state, None)
    if "access_token" not in result:
        print("Cannot refresh the token: {}: {}".format(
            result.get("error"), result.get("error_description")),
              file=sys.stderr)
        return (app_state, None)
    return (app_state, result["access_token"])

@contextlib.contextmanager
def token_lock(key):
    """Hold KEY's token cache while it is read, refreshed and written back.

    Callers such as mbsync and msmtp can run at once; each would refresh
    and write its own cache, the last write winning.
    """
    path = os.path.join(save_cache_path("oauth2ms"),
                        os.path.normpath(key).replace(os.sep, "%") + ".lock")
    with open(path, "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield

def encode_xoauth2(app_state, token):
    """
    Encode the xoauth 2 message based on:
https://docs.microsoft.com/en-us/exchange/client-developer/legacy-protocols/how-to-authenticate-an-imap-pop-smtp-application-by-using-oauth#sasl-xoauth2
    """
    accounts = app_state['app'].get_accounts()
    if not accounts:
        fail("No account in the token cache to encode the token for")
    username = accounts[0]["username"]

    C_A = b'\x01'
    user = ("user=" + username).encode("ascii")
    btoken = ("auth=Bearer " + token).encode("ascii")
    xoauth2_bytes = user + C_A + btoken + C_A + C_A
    return base64.b64encode(xoauth2_bytes).decode("utf-8")


def save_token(pass_store, key, data):
    """Store the token cache under KEY, committing it only if git wants it.

    passpy commits every key it writes, but a token changes on each
    refresh, so a store may well keep it out of git -- in which case the
    commit fails, noisily, after the key has been written.
    """
    repo = pass_store.repo
    path = os.path.join(pass_store.store_dir, os.path.normpath(key) + '.gpg')
    if repo is not None and repo.ignored(path):
        pass_store.repo = None
    try:
        pass_store.set_key(key, data, True)
    except git.exc.GitCommandError as e:
        print(e, file=sys.stderr)
    finally:
        pass_store.repo = repo

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--auth-key", action="store", default="oauth2ms",
                        help="Path to pass key which contains authentication credentials.")
    parser.add_argument("--token-key", action="store", default="oauth2ms",
                        help="Path to pass key where the access token will be stored.")
    parser.add_argument("--encode-xoauth2", action="store_true", default=False,
                        help="Print xoauth2 encoded token instead of the plain token")
    parser.add_argument("--no-browser", action="store_true", default=False,
                        help="Don't open a browser with URL. Instead print the URL.")
    parser.add_argument("--no-interactive", action="store_true", default=False,
                        help="Fail instead of signing in again when the token "
                        "cannot be refreshed: for use by mail programs, "
                        "where nobody is around to complete a sign-in.")

    cmdline_args = parser.parse_args()
    pass_store = passpy.Store()

    auth = pass_store.get_key(cmdline_args.auth_key)
    config = parse_key(auth) if auth is not None else None
    required_keys = ["authority", "client_id", "redirect_uri", "scopes"]
    if (config is None or not all([x in config for x in required_keys])):
        fail("Invalid config\nConfig must contain the keys: {}"
             .format(required_keys))
    if isinstance(config['scopes'], str):
        # A single `scopes:' line, which may hold several.
        config['scopes'] = config['scopes'].split()

    with token_lock(cmdline_args.token_key):
        app_state, token = cached_token(pass_store, cmdline_args.token_key,
                                        config)
        if token is None:
            if cmdline_args.no_interactive:
                fail("No usable token in {}; run oauth2ms --auth-key {} "
                     "--token-key {} to sign in again".format(
                         cmdline_args.token_key, cmdline_args.auth_key,
                         cmdline_args.token_key))
            app_state, token = build_new_app_state(config,
                                                   cmdline_args.no_browser)
            if token is None:
                fail("Could not get a token")

        if cmdline_args.encode_xoauth2:
            output = encode_xoauth2(app_state, token)
        else:
            output = token

        cache = app_state['cache']
        if cache.has_state_changed:
            save_token(pass_store, cmdline_args.token_key, cache.serialize())

    print(output)

if __name__ == "__main__":
    main()
